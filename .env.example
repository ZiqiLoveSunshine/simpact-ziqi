GOOGLE_API_KEY=your_key_here
GOOGLE_MODEL_ID=gemini-2.5-pro
ROBOT_HOST=172.16.0.2
SIMPACT_DATA_DIR=./data
SIMPACT_OUTPUTS_DIR=./outputs
SIMPACT_ROLLOUTS_DIR=./rollouts

# External perception model repos (real2sim Phase 4C) — paths to local clones.
# Only needed when running segmentation / image-to-3D / 6D pose stages.
# For the single-env rigid pipeline (SAM-3D + FoundationPose) see
# docs/RIGID_ENV_SETUP.md.
# Grounded-SAM-2: a repo clone is OPTIONAL (GroundingDINO comes from transformers,
# SAM2 + configs from the `sam2` wheel). The only required external artifact is the
# SAM2 checkpoint (~900 MB). See docs/RIGID_ENV_SETUP.md.
SIMPACT_GROUNDED_SAM2_DIR=/path/to/Grounded-SAM-2
SIMPACT_SAM2_CHECKPOINT=/path/to/sam2.1_hiera_large.pt
SIMPACT_HUNYUAN3D_DIR=/path/to/Hunyuan3D-2.1
SIMPACT_FOUNDATIONPOSE_DIR=./external/FoundationPose
SIMPACT_SAM3D_DIR=./external/sam-3d-objects

# --- VLM backend -------------------------------------------------------------
# Which provider the propose/verify/regress loop calls. "gemini" (default) uses
# GOOGLE_API_KEY above; "openai" targets ANY OpenAI-compatible /chat/completions
# server, which is how a LOCAL model (llama.cpp llama-server, vLLM, Ollama) drives
# the loop with no API key. See docs/LOCAL_VLM.md.
SIMPACT_VLM_BACKEND=gemini
SIMPACT_VLM_BASE_URL=http://127.0.0.1:8080/v1
SIMPACT_VLM_MODEL=qwen3vl
SIMPACT_VLM_API_KEY=no-key
SIMPACT_VLM_TEMPERATURE=0.7
SIMPACT_VLM_MAX_TOKENS=8192
# 1 = ask the server to constrain decoding to valid JSON (llama.cpp grammar).
# Every simpact VLM call parses JSON, so this is on by default; set 0 if your
# server rejects the response_format field.
SIMPACT_VLM_JSON_MODE=1
# 1 = when the task declares a primitive whitelist, compile it into the decoding
# grammar too (json_schema), not just post-hoc validation. Small models ignore the
# prompt's whitelist almost every time; this makes it unrepresentable.
SIMPACT_VLM_SCHEMA_MODE=1
